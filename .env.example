# =============================================================================
# 3D Expert — contoh konfigurasi environment
# =============================================================================
# Cara pakai:
#
#   cp .env.example .env
#   php artisan key:generate        # WAJIB: mengisi APP_KEY
#   # isi blok DB_* sesuai kredensial cPanel Anda
#   php artisan migrate
#   php artisan db:seed --class="Database\Seeders\LandingContentSeeder"
#   php artisan db:seed --class="Database\Seeders\LegacyServiceSeeder"
#   php artisan app:create-admin --role=superadmin
#
# Nilai di bawah ini adalah default yang aman untuk PRODUKSI di shared hosting
# cPanel. Komentar menandai mana yang wajib Anda ubah.
#
# JANGAN commit file .env ke git. Hanya .env.example yang boleh di-commit.
# =============================================================================


# -----------------------------------------------------------------------------
# Aplikasi
# -----------------------------------------------------------------------------
APP_NAME="3D Expert"

# 'production' mematikan pesan error detail dan mengaktifkan URL::forceScheme('https').
# Pakai 'local' hanya di komputer Anda sendiri.
APP_ENV=production

# Diisi oleh `php artisan key:generate`. Biarkan kosong di .env.example.
# Kalau key ini berubah, semua session dan data terenkripsi jadi tidak terbaca.
APP_KEY=

# WAJIB false di produksi. true akan menampilkan stack trace berisi path server,
# query, dan isi .env ke pengunjung mana pun yang memicu error.
APP_DEBUG=false

# UBAH ke domain asli, termasuk https://. Dipakai untuk membangun URL absolut
# di sitemap, canonical, hreflang, dan email.
APP_URL=https://3dexpert.id

# -----------------------------------------------------------------------------
# Bahasa
# -----------------------------------------------------------------------------
# PENTING: keduanya harus 'id'.
#
# Default Laravel adalah 'en'. Kalau dibiarkan 'en', seluruh konten Indonesia
# hasil `app:migrate-legacy-data` akan tersimpan di bawah kunci JSON "en",
# karena migrator menulis dengan config('app.fallback_locale') sebagai kunci
# locale. Akibatnya halaman /en ikut menampilkan teks Indonesia, dan datanya
# salah label secara permanen.
#
# Cek setelah migrasi:  SELECT title FROM services LIMIT 1;
# Kalau JSON-nya berisi kunci "en" untuk teks Indonesia, inilah penyebabnya.
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Zona waktu untuk timestamp yang ditampilkan di panel admin nanti.
# Laravel default 'UTC'; bisnis Anda di Surabaya (WIB = UTC+7).
APP_TIMEZONE=Asia/Jakarta

# -----------------------------------------------------------------------------
# Maintenance & log
# -----------------------------------------------------------------------------
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=error

# Berapa hari log disimpan. Legacy membiarkan error_log tumbuh tanpa batas dan
# membocorkan path server absolut.
LOG_DAILY_DAYS=14

# -----------------------------------------------------------------------------
# Database  — UBAH SEMUA NILAI DI BLOK INI
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ganti_nama_database
DB_USERNAME=ganti_user_database
DB_PASSWORD=ganti_password_database

# Wajib utf8mb4 supaya emoji dan karakter non-latin tidak rusak.
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# -----------------------------------------------------------------------------
# Database legacy — HANYA untuk menjalankan migrasi data, lalu kosongkan
# -----------------------------------------------------------------------------
# Dipakai oleh `php artisan app:migrate-legacy-data` untuk membaca database
# 3dexpert yang lama. Setelah migrasi selesai, kosongkan ketiga nilai ini
# supaya kredensial database lama tidak lagi tersimpan di server.
LEGACY_DB_CONNECTION=legacy
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

# -----------------------------------------------------------------------------
# Session  — blok paling penting untuk keamanan
# -----------------------------------------------------------------------------
SESSION_DRIVER=database

# Menit. 120 = 2 jam idle sebelum admin harus login lagi.
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false

# WAJIB true di produksi (HTTPS). config/session.php menulis
# env('SESSION_SECURE_COOKIE') tanpa default, jadi kalau baris ini tidak ada
# nilainya null dan Laravel membacanya sebagai false — cookie session ikut
# terkirim lewat HTTP biasa dan bisa disadap di jaringan publik.
# Set false HANYA saat development di http://localhost.
SESSION_SECURE_COOKIE=true

# Mencegah JavaScript membaca cookie session.
SESSION_HTTP_ONLY=true

# 'lax' mengizinkan cookie terkirim saat pengunjung mengklik link dari luar,
# tapi memblokir pengiriman pada POST lintas situs — proteksi CSRF berlapis.
SESSION_SAME_SITE=lax

# Isi dengan domain Anda supaya cookie tidak bocor ke subdomain lain.
# Kosongkan kalau belum yakin.
SESSION_DOMAIN=

# -----------------------------------------------------------------------------
# Cache & queue
# -----------------------------------------------------------------------------
# 'database' aman di shared hosting (tidak perlu Redis). Tabel cache sudah
# dibuat oleh migrasi 0001_01_01_000001_create_cache_table.
CACHE_STORE=database

# 'sync' menjalankan job langsung dalam request — cukup untuk situs ini, dan
# tidak butuh worker yang harus terus hidup (jarang tersedia di shared hosting).
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# Penyimpanan media
# -----------------------------------------------------------------------------
# Disk privat di storage/app/media, disalurkan lewat MediaController dan
# ServiceController::brochure(). JANGAN diubah ke 'public': legacy menulis
# upload langsung ke assets/images/ tanpa cek ekstensi, sehingga file .php
# yang diupload bisa dieksekusi server.
MEDIA_DISK=media
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Trusted proxies
# -----------------------------------------------------------------------------
# Kosong = tidak mempercayai proxy mana pun. Ini BENAR dan AMAN untuk cPanel /
# LiteSpeed yang menyajikan Apache langsung, yaitu kondisi Anda sekarang.
#
# Isi HANYA kalau ada proxy di depan aplikasi:
#   - Cloudflare / CDN, dan origin TIDAK bisa diakses langsung  -> TRUSTED_PROXIES=*
#   - load balancer dengan IP tetap                             -> TRUSTED_PROXIES=10.0.0.1,10.0.0.2
#
# Bahaya kalau salah: '*' sementara origin masih bisa diakses langsung membuat
# siapa pun bisa memalsukan header X-Forwarded-For, sehingga rate limit form
# kontak (throttle:5,10) bisa dilewati dan IP di contact_submissions jadi palsu.
TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# 'log' menulis email ke storage/logs alih-alih mengirimnya — aman sebagai
# default sampai SMTP benar-benar disiapkan. Form kontak tetap menyimpan
# submission ke database, jadi tidak ada data yang hilang.
MAIL_MAILER=log

# Kalau sudah siap pakai SMTP cPanel, ganti MAIL_MAILER=smtp lalu isi:
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@3dexpert.id"
MAIL_FROM_NAME="${APP_NAME}"

# CATATAN: belum ada notifikasi email untuk form kontak di codebase ini.
# ContactController hanya menyimpan submission ke tabel contact_submissions.
# Jadi blok MAIL_* di atas belum terpakai sampai fitur notifikasi dibuat —
# biarkan MAIL_MAILER=log sampai saat itu.

# -----------------------------------------------------------------------------
# Build front-end
# -----------------------------------------------------------------------------
# Dibutuhkan hanya saat `npm run dev`. Tidak perlu di produksi.
VITE_APP_NAME="${APP_NAME}"
