APP_NAME="3D Expert"
APP_ENV=production

APP_DEBUG=false
APP_URL=http://localhost:8000
FORCE_HTTPS=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Inisialisasi superadmin pertama lewat `php artisan app:init-admin`.
# Kosongkan password untuk diminta lewat prompt; jangan commit password asli.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

LEGACY_DB_CONNECTION=legacy
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=3dexpert
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false

# Set true only after HTTPS is active. Keep false while accessing the VPS IP over HTTP.
SESSION_SECURE_COOKIE=false

SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SESSION_DOMAIN=

# 'sync' menjalankan job langsung dalam request — cukup untuk situs ini, dan
# tidak butuh worker yang harus terus hidup (jarang tersedia di shared hosting).
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120

BROADCAST_CONNECTION=log


CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

MEDIA_DISK=media
FILESYSTEM_DISK=local

TRUSTED_PROXIES=

# Email production memakai Resend (https://resend.com).
# Package: resend/resend-laravel. Domain pengirim harus sudah berstatus
# "Verified" di dashboard Resend sebelum email dapat dikirim.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=info@3dexpert.pro
MAIL_FROM_NAME="${APP_NAME}"

# Fallback SMTP (tidak dipakai selama MAIL_MAILER=resend).
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@example.com
# MAIL_PASSWORD=
# MAIL_EHLO_DOMAIN=3dexpert.pro


# -----------------------------------------------------------------------------
# Midtrans Payment Gateway
# -----------------------------------------------------------------------------
# Sandbox keys are available at https://dashboard.sandbox.midtrans.com
# (Settings > Access Keys). Leave empty to keep online QRIS disabled; the site
# will still record the order and show a contact-admin message.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

# Pending payments hold a seat/enrollment for this many minutes.
PAYMENT_EXPIRY_MINUTES=15
