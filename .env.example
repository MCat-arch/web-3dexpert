APP_NAME="3D Expert"
APP_ENV=production

APP_DEBUG=false
APP_URL=http://localhost:8000
FORCE_HTTPS=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

LEGACY_DB_CONNECTION=legacy
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=3dexpert
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false

# Set true only after HTTPS is active. Keep false while accessing the VPS IP over HTTP.
SESSION_SECURE_COOKIE=false

SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SESSION_DOMAIN=

# 'sync' menjalankan job langsung dalam request — cukup untuk situs ini, dan
# tidak butuh worker yang harus terus hidup (jarang tersedia di shared hosting).
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120

BROADCAST_CONNECTION=log


CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

MEDIA_DISK=media
FILESYSTEM_DISK=local

TRUSTED_PROXIES=

# 'smtp' agar email verifikasi benar-benar terkirim via cPanel.
# PASTIKAN MAIL_PASSWORD DIISI DENGAN PASSWORD SMTP DARI cPanel (Email Accounts).
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=example.com
MAIL_FROM_ADDRESS=your-email@example.com
MAIL_FROM_NAME="${APP_NAME}"


# -----------------------------------------------------------------------------
# Midtrans Payment Gateway
# -----------------------------------------------------------------------------
